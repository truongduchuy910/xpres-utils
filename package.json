{
  "name": "xpres-utils",
  "version": "1.0.2",
  "author": "truongduchuy910",
  "repository": {
    "type": "git",
    "url": "https://github.com/truongduchuy910/xpres-utils.git"
  },
  "bugs": {
    "url": "https://github.com/truongduchuy910/xpres-utils/issues"
  },
  "homepage": "https://github.com/truongduchuy910/xpres-utils#readme",
  "license": "ISC",
  "engines": {
    "node": ">=22",
    "yarn": "use npm!",
    "pnpm": "use npm!"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "format:diff": "git diff HEAD --name-only --diff-filter=d -z | xargs -0 -r -- prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
    "format:others": "git ls-files --others --exclude-standard | xargs -r -- prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
    "format": "npm run format:diff && npm run format:others",
    "build": "tsup",
    "semantic-release": "semantic-release",
    "test": "jest"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.12.11",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "jest": "^30.0.4",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "express": "^5.2.0",
    "yup": "^1.6.1"
  }
}
